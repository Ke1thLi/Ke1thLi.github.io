---
import { siteConfig } from "../lib/site-config";
import ThemeScript from "../components/ThemeScript.astro";
import PageMetadata from "../components/PageMetadata.astro";
import FontResources from "../components/FontResources.astro";
import Sidebar from "../components/shell/Sidebar.astro";
import Topbar from "../components/shell/Topbar.astro";
import Footer from "../components/shell/Footer.astro";
import SearchDialog from "../components/shell/SearchDialog.astro";
import Icon from "../components/shell/Icon.astro";
import SiteBrand from "../components/shell/SiteBrand.astro";
import { preferenceKey } from "../lib/preferences";
import "../styles/base.css";
import "../styles/editorial.css";
import "../styles/shell.css";

interface Props {
  title: string;
  section?: { label: string; href: string };
  reading?: boolean;
  readingTime?: number;
  showHeading?: boolean;
  description?: string;
  lang?: string;
  noindex?: boolean;
  article?: { published: Date; updated?: Date; tags: string[] };
}

const {
  title,
  section,
  reading = false,
  readingTime,
  showHeading = true,
  description,
  lang = siteConfig.lang,
  noindex,
  article,
} = Astro.props;
const sidebarKey = preferenceKey("sidebar");
---

<!doctype html>
<html
  lang={lang}
  style={[
    siteConfig.appearance.accentColor && `--accent-override:${siteConfig.appearance.accentColor}`,
    siteConfig.appearance.fontFamily && `--font-ui:${siteConfig.appearance.fontFamily}`,
  ]
    .filter(Boolean)
    .join(";")}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageMetadata {title} {section} {description} {lang} {noindex} {article} />
    <ThemeScript />
    <script is:inline define:vars={{ sidebarKey }}>
      try {
        if (["hidden", "collapsed"].includes(localStorage.getItem(sidebarKey) ?? "")) {
          document.documentElement.dataset.sidebar = "collapsed";
        }
      } catch {
        // The sidebar remains available without storage.
      }
    </script>
    <FontResources />
  </head>
  <body id="top" tabindex="-1">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="app-shell">
      <aside class="desktop-sidebar" id="desktop-sidebar" lang="en">
        <SiteBrand />
        <div class="sidebar-navigation" id="sidebar-navigation">
          <Sidebar />
          <Sidebar compact />
        </div>
        <div class="sidebar-footer">
          {siteConfig.rssUrl && (
            <a class="shell-icon" href={siteConfig.rssUrl} aria-label="RSS" title="RSS">
              <Icon name="rss" />
            </a>
          )}
          <button
            class="rail-toggle sidebar-toggle"
            type="button"
            data-sidebar-toggle
            aria-controls="sidebar-navigation"
            aria-label="Collapse sidebar"
            aria-expanded="true"
            title="Collapse sidebar"
          >
            <Icon name="railChevron" />
          </button>
        </div>
      </aside>
      <div class="shell-column">
        <Topbar title={title} section={section} lang={lang} />
        {article && (
          <div class="reading-progress" aria-hidden="true">
            <span data-reading-progress></span>
          </div>
        )}
        <main
          id="main-content"
          class:list={["shell-main", { "shell-reading": reading }]}
          tabindex="-1"
        >
          {showHeading && <h1>{title}</h1>}
          <slot />
        </main>
        <Footer {readingTime} />
      </div>
    </div>
    <dialog class="nav-drawer" id="navigation-drawer" aria-label="Site navigation" lang="en">
      <div class="drawer-body">
        <div class="drawer-header">
          <SiteBrand />
          <button
            class="shell-icon"
            type="button"
            data-drawer-close
            aria-label="Close navigation"
            autofocus
          >
            <Icon name="close" />
          </button>
        </div>
        <Sidebar />
        <div class="drawer-footer">
          {siteConfig.githubUrl && (
            <a
              class="shell-icon"
              href={siteConfig.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub (opens in a new tab)"
              title="GitHub"
            >
              <Icon name="github" />
            </a>
          )}
          {siteConfig.rssUrl && (
            <a class="shell-icon" href={siteConfig.rssUrl} aria-label="RSS" title="RSS">
              <Icon name="rss" />
            </a>
          )}
        </div>
      </div>
    </dialog>
    {siteConfig.features.search && <SearchDialog />}
    <script src="../scripts/shell.ts"></script>
  </body>
</html>
