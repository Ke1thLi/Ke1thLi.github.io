---
import { getEntry, render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import Page from "../../layouts/Page.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import ProjectList from "../../components/ProjectList.astro";
import PostList from "../../components/PostList.astro";
import { articlePath, readingMinutes, relatedPosts } from "../../lib/article-list";
import { getPublicPosts } from "../../lib/public-content";
import { sitePath } from "../../lib/routes";
import { siteConfig } from "../../lib/site-config";
import Icon from "../../components/shell/Icon.astro";
import "katex/dist/katex.min.css";
import "../../styles/article.css";

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
      related: relatedPosts(post, posts),
    },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, newer, older, related } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const language = data.lang ?? siteConfig.lang;
const chinese = /^zh(?:-|$)/i.test(language);
const readingTime = readingMinutes(post.body);
const dateLabel = (date: Date) => date.toISOString().slice(0, 10);
const projects = await Promise.all(
  post.data.projects.map(async (id) => {
    const project = await getEntry("projects", id);
    if (!project) throw new Error(`Post "${post.id}" references missing project "${id}"`);
    return project;
  }),
);
---

<Page
  title={post.data.title}
  description={post.data.description}
  lang={language}
  article={{ published: post.data.pubDate, updated: post.data.updatedDate, tags: post.data.tags }}
  showHeading={false}
  {readingTime}
  section={
    post.data.category
      ? { label: post.data.category, href: sitePath("categories", post.data.category) }
      : undefined
  }
>
  <a class="article-back-link" href={sitePath("articles")}>
    <Icon name="chevron" /> {chinese ? "返回文章列表" : "All articles"}
  </a>
  <div class="article-layout">
    <ArticleToc headings={headings.filter(({ depth }) => depth >= 2 && depth <= 4)} {chinese} />
    <article class="article-content" data-pagefind-body>
      <header class="article-header">
        {(data.category || data.tags.length > 0) && (
          <ul class="article-taxonomy" aria-label={chinese ? "文章主题" : "Article topics"}>
            {data.category && (
              <li class="article-category">
                <a href={articlePath({ kind: "category", value: data.category })}>
                  {data.category}
                </a>
              </li>
            )}
            {data.tags.map((tag) => (
              <li>
                <a href={articlePath({ kind: "tag", value: tag })}>{tag}</a>
              </li>
            ))}
          </ul>
        )}
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p data-pagefind-meta="description">{post.data.description}</p>
        {post.data.category && (
          <span hidden data-pagefind-meta={`category:${post.data.category}`}></span>
        )}
        <span hidden data-pagefind-meta={`tags:${JSON.stringify(post.data.tags)}`}></span>
        <div class="article-byline">
          <span class="article-author" lang={siteConfig.lang}>
            {siteConfig.avatarUrl ? (
              <img
                class="article-author-mark"
                src={siteConfig.avatarUrl}
                alt=""
                width="26"
                height="26"
              />
            ) : (
              <span class="article-author-mark" aria-hidden="true">
                {[...siteConfig.author][0]}
              </span>
            )}
            {siteConfig.author}
          </span>
          <time datetime={data.pubDate.toISOString()}>{dateLabel(data.pubDate)}</time>
          {data.updatedDate && (
            <span>
              {chinese ? "更新于 " : "Updated "}
              <time datetime={data.updatedDate.toISOString()}>{dateLabel(data.updatedDate)}</time>
            </span>
          )}
          <span>{chinese ? "约 " + readingTime + " 分钟阅读" : readingTime + " min read"}</span>
        </div>
      </header>
      <div class="prose" data-article-body>
        <Content />
      </div>
      <footer class="article-footer" data-pagefind-ignore>
        {related.length > 0 && (
          <section aria-labelledby="related-articles">
            <h2 id="related-articles">{chinese ? "相关文章" : "Related articles"}</h2>
            <PostList posts={related} />
          </section>
        )}
        {projects.length > 0 && (
          <section>
            <h2>{chinese ? "相关项目" : "Related projects"}</h2>
            <ProjectList projects={projects} headingLevel={3} />
          </section>
        )}
        <nav aria-label={chinese ? "文章导航" : "Article navigation"}>
          {newer && (
            <a href={sitePath("posts", newer.id)}>
              {chinese ? "上一篇：" : "Previous: "}
              {newer.data.title}
            </a>
          )}
          {older && (
            <a href={sitePath("posts", older.id)}>
              {chinese ? "下一篇：" : "Next: "}
              {older.data.title}
            </a>
          )}
          <a href={sitePath("articles")}>{chinese ? "返回文章列表" : "Back to articles"}</a>
        </nav>
      </footer>
    </article>
  </div>
  <dialog class="image-lightbox" data-lightbox aria-label="Article image">
    <button class="button" data-lightbox-close type="button" autofocus>
      Close image
    </button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
  </dialog>
  <script src="../../scripts/article.ts"></script>
</Page>
