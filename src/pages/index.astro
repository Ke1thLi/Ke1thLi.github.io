---
import { getCollection } from "astro:content";
import HomeHero from "../components/HomeHero.astro";
import Page from "../layouts/Page.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import { sitePath } from "../lib/routes";
import { siteConfig } from "../lib/site-config";
import { groupByCategory } from "../lib/article-list";
import { getPublicPosts } from "../lib/public-content";

const posts = await getPublicPosts();
const projects = (await getCollection("projects")).filter(({ data }) => data.featured).slice(0, 3);
const categories = groupByCategory(posts);
---

<Page title={siteConfig.title} showHeading={false}>
  <HomeHero />
  <section aria-labelledby="recent-articles">
    <h2 id="recent-articles">Recent articles</h2>
    <PostList posts={posts.slice(0, siteConfig.home.recentPosts)} />
    <a href={sitePath("articles")}>View all articles</a>
  </section>
  <section aria-labelledby="featured-articles">
    <h2 id="featured-articles">Featured articles</h2>
    <PostList
      posts={posts.filter(({ data }) => data.featured).slice(0, siteConfig.home.featuredPosts)}
      empty="No featured articles yet."
    />
  </section>
  <section aria-labelledby="featured-projects">
    <h2 id="featured-projects">Featured projects</h2>
    <ProjectList projects={projects} empty="No featured projects yet." headingLevel={3} />
    <a href={sitePath("projects")}>View all projects</a>
  </section>
  <section aria-labelledby="home-categories">
    <h2 id="home-categories">Categories</h2>
    {categories.size ? (
      <ul class="categories">
        {[...categories]
          .sort(([a], [b]) => a.localeCompare(b))
          .map(([category, entries]) => (
            <li>
              <a href={sitePath("categories", category)}>{category}</a>{" "}
              <span class="muted">({entries.length})</span>
            </li>
          ))}
      </ul>
    ) : (
      <p class="muted">Categories will appear as articles are published.</p>
    )}
  </section>
</Page>
<style>
  section {
    margin-block-start: var(--space-10);
  }
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
</style>
