---
import TaxonomyAccordion from "../../components/TaxonomyAccordion.astro";
import Page from "../../layouts/Page.astro";
import type { Post } from "../../lib/article-list";
import { getPublicPosts } from "../../lib/public-content";
import { sitePath, tagRouteKey } from "../../lib/routes";

const taggedPosts = new Map<string, Post[]>();
for (const post of await getPublicPosts()) {
  for (const tag of new Set(post.data.tags)) {
    const group = taggedPosts.get(tag);
    if (group) group.push(post);
    else taggedPosts.set(tag, [post]);
  }
}
const tags = [...taggedPosts].sort(([a], [b]) => a.localeCompare(b));
---

<Page title="Tags" description="Browse the blog's published articles by tag." reading>
  {tags.length === 0 ? (
    <p class="muted">Tags will appear as articles are published.</p>
  ) : (
    <TaxonomyAccordion
      groups={tags.map(([label, posts]) => ({
        label,
        href: sitePath("tags", tagRouteKey(label)),
        posts,
      }))}
    />
  )}
</Page>
