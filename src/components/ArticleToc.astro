---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
---

{headings.length > 0 && (
  <details class="article-toc" data-toc>
    <summary>
      <span>On this page</span>
      <span class="rail-toggle toc-toggle" aria-hidden="true"></span>
    </summary>
    <nav aria-label="Article contents">
      <ol>
        {headings.map(({ depth, slug, text }) => (
          <li class:list={[{ "toc-subheading": depth === 3 }]}>
            <a href={`#${encodeURIComponent(slug)}`}>{text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}
