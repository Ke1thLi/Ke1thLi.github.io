---
import Icon from "./shell/Icon.astro";

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  chinese?: boolean;
}
const { headings, chinese = false } = Astro.props;
---

{headings.length > 0 && (
  <details class="article-toc" data-toc>
    <summary>
      <span>{chinese ? "目录" : "On this page"}</span>
      <span class="toc-toggle" aria-hidden="true">
        <Icon name="chevron" />
      </span>
    </summary>
    <nav aria-label={chinese ? "文章目录" : "Article contents"}>
      <ol>
        {headings.map(({ depth, slug, text }) => (
          <li class:list={[{ "toc-subheading": depth === 3, "toc-nested-heading": depth === 4 }]}>
            <a href={`#${encodeURIComponent(slug)}`}>{text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}
