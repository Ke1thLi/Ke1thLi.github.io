---
import { siteConfig } from "../lib/site-config";
---

<header class:list={["hero", { "has-custom-background": siteConfig.backgroundUrl }]}>
  {siteConfig.backgroundUrl && (
    <img src={siteConfig.backgroundUrl} alt="" width="960" height="480" fetchpriority="high" />
  )}
  <div>
    <h1>{siteConfig.title}</h1>
    <p class="hero-introduction">{siteConfig.home.introduction}</p>
    {siteConfig.home.technicalFocus && <p class="hero-focus">{siteConfig.home.technicalFocus}</p>}
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: start;
    min-block-size: 8.25rem;
    padding-block-end: var(--space-5);
  }

  .hero::before,
  .hero::after,
  .hero img {
    position: absolute;
    inset-block-start: calc(-1 * var(--space-4));
    inset-inline-end: 0;
    z-index: -1;
    border-radius: var(--radius-lg);
    pointer-events: none;
  }

  .hero::before {
    content: "";
    inline-size: min(72%, 53rem);
    block-size: calc(100% + var(--space-4));
    background: radial-gradient(ellipse at 82% 5%, light-dark(#e8dcfb, #382644), transparent 75%);
  }

  .hero::after {
    content: "";
    inline-size: min(48%, 37rem);
    block-size: calc(100% + var(--space-4));
    clip-path: ellipse(60% 122% at 100% 125%);
    background: linear-gradient(160deg, light-dark(#dfd3fb, #29244e) 25%, transparent 91%);
  }

  .hero.has-custom-background::before,
  .hero.has-custom-background::after {
    content: none;
  }

  .hero img {
    inline-size: min(72%, 53rem);
    block-size: calc(100% + var(--space-4));
    object-fit: cover;
    mask-image: linear-gradient(90deg, transparent 5%, #000);
    opacity: 0.5;
  }

  .hero h1 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-hero-h1);
  }

  .hero p {
    max-inline-size: 53ch;
    margin-block: var(--space-2) 0;
  }

  .hero-introduction {
    color: var(--text);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }

  .hero-focus {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    .hero {
      min-block-size: auto;
    }
  }
</style>
