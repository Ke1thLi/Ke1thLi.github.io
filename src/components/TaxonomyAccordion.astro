---
import type { Post } from "../lib/article-list";
import { sitePath } from "../lib/routes";
import Icon from "./shell/Icon.astro";

interface Props {
  groups: { label: string; href: string; posts: Post[] }[];
}
const { groups } = Astro.props;
---

<div class="taxonomy-groups">
  {groups.map(({ label, href, posts }) => (
    <details>
      <summary>
        <span>{label}</span>
        <span class="count">
          {posts.length} {posts.length === 1 ? "article" : "articles"}
        </span>
        <Icon name="railChevron" />
      </summary>
      <ul>
        {posts.map(({ id, data }) => (
          <li>
            <a href={sitePath("posts", id)}>{data.title}</a>
            <time datetime={data.pubDate.toISOString()}>
              {data.pubDate.toISOString().slice(0, 10)}
            </time>
          </li>
        ))}
      </ul>
      <a class="group-link" href={href}>
        View all in {label}
      </a>
    </details>
  ))}
</div>
<style>
  .taxonomy-groups {
    display: grid;
    gap: var(--space-2);
  }
  details {
    border: var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
    cursor: pointer;
    padding: var(--space-3) var(--space-4);
    font-weight: var(--weight-semibold);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  details[open] > summary {
    color: var(--accent);
    background: var(--accent-soft);
  }
  details[open] > summary svg {
    rotate: 90deg;
  }
  .count,
  time {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-4);
  }
  li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--space-4);
    padding-block: var(--space-2);
    border-block-end: var(--rule);
  }
  li a {
    min-inline-size: 0;
    color: var(--text);
  }
  li a:hover {
    color: var(--accent);
  }
  .group-link {
    display: inline-block;
    margin: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
  }
</style>
