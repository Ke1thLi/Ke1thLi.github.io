---
import { sitePath } from "../lib/routes";
import type { Post } from "../lib/article-list";
import PostMetadata from "./PostMetadata.astro";
import Icon from "./shell/Icon.astro";
interface Props {
  posts: Post[];
  empty?: string;
  compact?: boolean;
}
const { posts, empty = "No published articles.", compact = false } = Astro.props;
---

{posts.length === 0 ? (
  <p class="muted">{empty}</p>
) : (
  <ul class:list={["post-list", { "post-list-compact": compact }]}>
    {posts.map((post) => (
      <li>
        {compact ? (
          <a class="post-row" href={sitePath("posts", post.id)}>
            <Icon name="articles" />
            <span>{post.data.title}</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
          </a>
        ) : (
          <>
            <a class="post-title" href={sitePath("posts", post.id)}>
              {post.data.title}
            </a>
            <p>{post.data.description}</p>
            <PostMetadata post={post} />
          </>
        )}
      </li>
    ))}
  </ul>
)}

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin-block: var(--space-3) 0;
  }

  .post-list li {
    padding-block: var(--space-4);
    border-block-start: var(--rule);
  }

  .post-title {
    color: var(--text);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
  }

  p {
    margin-block: var(--space-1) var(--space-2);
    color: var(--text-muted);
  }

  .post-list-compact {
    margin-block-start: 0;
  }

  .post-list-compact li {
    padding: 0;
    border-block-start: 0;
  }

  .post-list-compact li + li {
    border-block-start: var(--rule);
  }

  .post-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 2.75rem;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .post-row:hover {
    background: var(--surface-muted);
    color: var(--accent-hover);
  }

  .post-row span {
    overflow-wrap: anywhere;
  }

  .post-row time {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
