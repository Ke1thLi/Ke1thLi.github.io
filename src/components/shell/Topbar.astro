---
import { siteConfig } from "../../lib/site-config";
import { sitePath } from "../../lib/routes";
import Icon from "./Icon.astro";
import SiteBrand from "./SiteBrand.astro";

interface Props {
  title: string;
  lang: string;
  section?: { label: string; href: string };
}

const { title, section, lang } = Astro.props;
const home = Astro.url.pathname === sitePath();
const article = Astro.url.pathname.startsWith(sitePath("posts"));
---

<header class="shell-topbar" lang="en">
  <div class="topbar-start">
    <div class="topbar-brand">
      <SiteBrand />
    </div>
    {!home && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {article && (
            <li>
              <a href={sitePath("articles")}>Articles</a>
            </li>
          )}
          {section && (
            <li>
              <a href={section.href}>{section.label}</a>
            </li>
          )}
          <li aria-current="page" lang={lang}>
            {title}
          </li>
        </ol>
      </nav>
    )}
  </div>
  <div class="topbar-actions">
    {siteConfig.features.search && (
      <button
        class="shell-icon search-trigger"
        type="button"
        data-search-open
        aria-label="Search articles"
        aria-controls="article-search"
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <Icon name="search" />
        <span class="search-trigger-label">Search articles...</span>
        <kbd aria-hidden="true">Ctrl K</kbd>
      </button>
    )}
    <button
      class="shell-icon theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Dark theme"
      aria-pressed="false"
      title="Toggle dark theme"
    >
      <span class="theme-sun">
        <Icon name="sun" />
      </span>
      <span class="theme-moon">
        <Icon name="moon" />
      </span>
    </button>
    <button
      class="shell-icon theme-reset"
      type="button"
      data-theme-reset
      aria-label="Follow system theme"
      title="Follow system theme"
      hidden
    >
      <Icon name="system" />
    </button>
    {siteConfig.githubUrl && (
      <a
        class="shell-icon topbar-github"
        href={siteConfig.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub (opens in a new tab)"
        title="GitHub"
      >
        <Icon name="github" />
      </a>
    )}
    <button
      class="shell-icon mobile-toggle"
      type="button"
      data-drawer-open
      aria-label="Open navigation"
      aria-controls="navigation-drawer"
      aria-haspopup="dialog"
    >
      <Icon name="menu" />
    </button>
  </div>
</header>
