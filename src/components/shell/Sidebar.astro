---
import { sitePath } from "../../lib/routes";
import Icon from "./Icon.astro";

const groups = [
  [
    "Workspace",
    [
      ["Home", "home", ""],
      ["Articles", "articles", "articles"],
      ["Projects", "projects", "projects"],
      ["Archives", "archives", "archives"],
    ],
  ],
  [
    "Discover",
    [
      ["Categories", "categories", "categories"],
      ["Tags", "tags", "tags"],
    ],
  ],
  ["About", [["About", "about", "about"]]],
] as const;

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const pathname = Astro.url.pathname;
const active = (path: string, href: string) =>
  href === pathname
    ? "page"
    : (path && pathname.startsWith(href)) ||
        (path === "articles" && pathname.startsWith(sitePath("posts")))
      ? "location"
      : undefined;
---

<nav class:list={["side-nav", { "side-nav-compact": compact }]} aria-label="Main navigation">
  {groups.map(([group, links]) => {
    const items = links.map(([label, icon, path]) => {
      const href = path ? sitePath(path) : sitePath();
      return (
        <a
          href={href}
          aria-current={active(path, href)}
          aria-label={label}
          title={compact ? label : undefined}
        >
          <Icon name={icon} />
          {!compact && <span>{label}</span>}
        </a>
      );
    });
    return compact ? (
      <div>{items}</div>
    ) : (
      <details data-nav-group={group} open>
        <summary>
          {group}
          <Icon name="chevron" />
        </summary>
        {items}
      </details>
    );
  })}
</nav>
