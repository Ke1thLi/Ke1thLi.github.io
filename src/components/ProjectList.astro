---
import type { CollectionEntry } from "astro:content";
import { sitePath } from "../lib/routes";
import Icon from "./shell/Icon.astro";
interface Props {
  projects: CollectionEntry<"projects">[];
  empty?: string;
  headingLevel?: 2 | 3;
  compact?: boolean;
}
const {
  projects,
  empty = "No projects have been published.",
  headingLevel = 2,
  compact = false,
} = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

{projects.length === 0 ? (
  <p class="muted">{empty}</p>
) : (
  <ul class:list={["project-list", { "project-list-compact": compact }]}>
    {projects.map(({ id, data }) => (
      <li>
        {compact && (
          <span class="project-icon">
            <Icon name="projects" />
          </span>
        )}
        <div class="project-summary">
          <Heading class="project-heading">
            <a href={sitePath("projects", id)}>{data.title}</a>
            {!compact && data.featured && <span class="project-featured">Featured</span>}
          </Heading>
          <p>{data.description}</p>
          {!compact && (
            <ul class="project-labels" aria-label="Status and technologies">
              {[data.status, ...data.techStack].map((label) => (
                <li>{label}</li>
              ))}
            </ul>
          )}
          {(data.repository || data.demo) && (
            <div class="project-links">
              {data.repository && <a href={data.repository}>Repository</a>}
              {data.demo && <a href={data.demo}>Demo</a>}
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .project-list,
  .project-labels {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-list {
    display: grid;
    gap: var(--space-3);
  }

  .project-list > li {
    min-inline-size: 0;
    padding: var(--space-4);
    border: var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .project-summary {
    overflow-wrap: anywhere;
  }

  .project-heading,
  p {
    margin-block: 0 var(--space-2);
  }

  .project-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--text);
    font-size: var(--text-h4);
  }

  .project-heading a {
    color: inherit;
    text-decoration: none;
  }

  .project-heading a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  p {
    color: var(--text-muted);
  }

  .project-links,
  .project-labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-links {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
  }

  .project-featured,
  .project-labels li {
    padding: 0.125rem var(--space-2);
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .project-featured {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .project-list-compact {
    gap: 0;
  }

  .project-list-compact > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-3);
    padding: var(--space-2);
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .project-list-compact > li + li {
    border-block-start: var(--rule);
  }

  .project-icon {
    display: grid;
    place-items: center;
    inline-size: var(--space-8);
    block-size: var(--space-8);
    border-radius: 50%;
    background: var(--surface-muted);
    color: var(--text);
  }

  .project-list-compact .project-heading,
  .project-list-compact p {
    font-size: var(--text-sm);
  }

  .project-list-compact .project-heading {
    margin-block-end: var(--space-1);
  }

  .project-list-compact p {
    margin-block-end: 0;
  }
</style>
